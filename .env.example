# Public canonical HTTPS origin in production; localhost only for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Only publish real, monitored contact details.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Generate using: openssl rand -hex 32
RATE_LIMIT_SECRET=
# Optional Resend is not enabled in this implementation. See README.
